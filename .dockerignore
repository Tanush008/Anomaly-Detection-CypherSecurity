# =============================================================================
# .dockerignore
# =============================================================================
# Excludes files from the Docker build context sent to the daemon.
# Keeps the image clean and the build fast.
# =============================================================================

# ── Python runtime artifacts ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environment ───────────────────────────────────────────────────────
# Never copy the local venv — the Dockerfile installs deps from scratch.
venv/
.venv/
env/
.env/

# ── Generated data & model files ─────────────────────────────────────────────
# These are either mounted via volumes at runtime (docker-compose) or
# regenerated by running the trainer container.
data/access_logs.csv
data/scored_logs.csv
models_saved/

# ── Generated report PDF ──────────────────────────────────────────────────────
report/anomaly_detection_report.pdf

# ── Git metadata ──────────────────────────────────────────────────────────────
.git/
.gitignore

# ── IDE & editor files ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Test / CI artifacts ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ── Documentation (not needed inside the container) ──────────────────────────
README.md
CODE_EXPLAINED.md

# ── Logs & temp files ─────────────────────────────────────────────────────────
*.log
tmp/
temp/
